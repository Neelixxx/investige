# Core app
SESSION_SECRET=replace-with-a-random-secret
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Dev-only strictness toggle (default off)
AUTH_REQUIRE_EMAIL_VERIFICATION=0
# Temporary staging/prod bypass (set to 1 only when needed)
AUTH_ALLOW_UNVERIFIED_LOGIN=0
# Dev-only analytics override (shows seeded analytics until live data is ready)
ALLOW_SEEDED_ANALYTICS=0

# Storage (optional; file storage is used when DATABASE_URL is empty/non-postgres)
DATABASE_URL=

# External data providers
POKEMONTCG_API_KEY=
EUR_TO_USD_RATE=1.08

# Optional legacy Direct TCGplayer OAuth ingestion
# Leave blank if you are using PokemonTCG API only.
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_ACCESS_TOKEN=
TCGPLAYER_CATEGORY_ID=3

# Optional live population feeds (JSON array/object via URL or local file)
PSA_POPULATION_FEED_URL=
PSA_POPULATION_FEED_FILE=
TAG_POPULATION_FEED_URL=
TAG_POPULATION_FEED_FILE=
# Optional PSA cert lookup integration (used by Settings > Data Sources > PSA Cert API Import)
PSA_API_BASE_URL=https://api.psacard.com
PSA_API_BEARER_TOKEN=
POPULATION_FEED_TIMEOUT_MS=10000
SEALED_SALES_FEED_URL=
SEALED_SALES_FEED_FILE=
SEALED_SALES_FEED_TIMEOUT_MS=12000

# Queue + worker
REDIS_URL=
WORKER_TICK_MS=30000
WORKER_CONCURRENCY=2

# In-process scheduler + cron endpoint
SCHEDULER_TICK_MS=60000
DISABLE_BACKGROUND_SCHEDULER=0
CRON_SECRET=replace-with-cron-secret

# Email provider
RESEND_API_KEY=
EMAIL_FROM=Investige <no-reply@gemindex.local>

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=
